+static std::mutex command_queue_mutex;
+static id<MTLCommandQueue> last_committed_queue = nil;
+static void (*original_drawable_present)(id, SEL) = nullptr;
+static void (*original_commit)(id, SEL) = nullptr;
+
+static void MyMTLCommandBufferCommit(id self, SEL sel)
+{
+    id<MTLCommandQueue> queue = [(id<MTLCommandBuffer>)self commandQueue];
+    if (queue) {
+        std::lock_guard<std::mutex> lock(command_queue_mutex);
+        if (queue != last_committed_queue) {
+            [queue retain];
+            [last_committed_queue release];
+            last_committed_queue = queue;
+        }
+    }
+    original_commit(self, sel);
+}
