+        inst->_PrepareForOverlay((id<MTLDrawable>)self, texture, overlayBuffer);
+        [overlayBuffer commit];
+        inst->_RenderPass.clear();
+    }
+    [queue release];
+    original_drawable_present(self, sel);
+}
