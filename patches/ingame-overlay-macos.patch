+{
+    MetalHook_t* inst = MetalHook_t::Inst();
+    id<MTLTexture> texture = [(id<CAMetalDrawable>)self texture];
+    id<MTLCommandQueue> queue = nil;
+    {
+        std::lock_guard<std::mutex> lock(command_queue_mutex);
+        queue = [last_committed_queue retain];
+    }
+
+    if (inst->_Hooked && texture && queue && (!inst->_Initialized || inst->_OverlayProcessingEnabled.load())) {
